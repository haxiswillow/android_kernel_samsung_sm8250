# Mushroom performance batch 1; Android 13 / r8q.
CONFIG_PREEMPT=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_1000=y
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# Keep Qualcomm WALT/schedtune: this branch makes it exclusive with UCLAMP.
# CONFIG_UCLAMP_TASK is not set
CONFIG_SCHED_TUNE=y
# Keep scheduler sysctls and tracepoints for Android HAL/tool compatibility.
CONFIG_SCHED_DEBUG=y
# CONFIG_LATENCYTOP is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_PROFILING is not set
# CONFIG_GATOR is not set
# CONFIG_DEBUG_QSPINLOCK_OWNER is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SEC_DEBUG_SCHED_LOG is not set
# CONFIG_SEC_DEBUG_SUMMARY is not set
# CONFIG_SEC_DEBUG_APPS_CLK_LOGGING is not set
# CONFIG_SEC_DEBUG_DUMP_TASK_STACK is not set
# CONFIG_SEC_DEBUG_MDM_FILE_INFO is not set
# CONFIG_SEC_DEBUG_MODULE_INFO is not set
# CONFIG_SEC_DEBUG_TSP_LOG is not set
# CONFIG_MUSHROOM_VERBOSE_DEBUG is not set
CONFIG_MUSHROOM_KCAL=y
CONFIG_MUSHROOM_UI=y
CONFIG_CRYPTO_LZ4=y
# CONFIG_PM_DEBUG is not set
# CONFIG_PM_SLEEP_DEBUG is not set
# CONFIG_PM_ADVANCED_DEBUG is not set

# Batch 4: complete 4.19 multi-gen LRU backport; retain runtime fallback.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_LRU_GEN_STATS is not set
CONFIG_MUSHROOM_BG_CPUSET=y
# EXT4 target: encryption, ACL, quotas and metadata checksums stay enabled.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_FS_ENCRYPTION=y
# CONFIG_EXT4_DEBUG is not set
# CONFIG_JBD2_DEBUG is not set
CONFIG_CRYPTO_CRC32_ARM64_CE=y
# System/vendor are EXT4, but this r8q has F2FS userdata. Keep both built in.
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y

# v7.4: this Samsung UFS driver uses single-queue SCSI (runtime PM).
# Keep CFQ/noop available for runtime comparisons; use Deadline by default.
CONFIG_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_CFQ=y
CONFIG_DEFAULT_DEADLINE=y
# CONFIG_DEFAULT_CFQ is not set
# CONFIG_DEFAULT_NOOP is not set
CONFIG_DEFAULT_IOSCHED="deadline"
# Restrict anonymous THP to applications that explicitly request it.
CONFIG_TRANSPARENT_HUGEPAGE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
